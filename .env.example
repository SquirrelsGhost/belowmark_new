# ============================================================
# ENVIRONMENT VARIABLE TEMPLATE
# This file IS committed to git — it shows which variables
# are required. Never put real secrets here.
#
# To set up locally:
#   cp .env.example .env.local
#   fill in the values in .env.local
# ============================================================

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=                  # Public URL of the app (e.g. https://belowmark.com) — used in e-mail links

# ── PostgreSQL (Neon / Standard Postgres) ───────────────────
DATABASE_URL=                         # Pooled PostgreSQL connection string (e.g. postgresql://user:pass@ep-…-pooler.neon.tech/neondb?sslmode=require)
DATABASE_URL_UNPOOLED=                # Direct (non-pooled) connection string for migrations
POSTGRES_URL=                         # Optional Vercel/Neon alias for DATABASE_URL
POSTGRES_URL_NON_POOLING=             # Optional Vercel/Neon alias for DATABASE_URL_UNPOOLED

# ── Mail (SMTP) ─────────────────────────────────────────────
# Without SMTP_HOST, development prints every mail (with its link) to the
# server console; production refuses sign-up and reset instead of promising
# a mail that never arrives.
SMTP_HOST=                            # e.g. smtp.example.com
SMTP_PORT=465                         # 465 = TLS, 587 = STARTTLS
SMTP_USER=
SMTP_PASS=
MAIL_FROM=                            # e.g. Belowmark <kontakt@belowmark.com>

# ── Auth ────────────────────────────────────────────────────
AUTH_BREACH_CHECK=on                  # "off" disables the Have-I-Been-Pwned check for new passwords
SESSION_SECRET=                       # HMAC-SHA256 secret (>= 32 chars) for signing session cookies

# Lokale Schnell-Logins auf /login (nur unter npm run dev). "off" blendet sie aus.
# AUTH_DEV_LOGIN=off

# ── Alerts ──────────────────────────────────────────────────
# Secret for POST /api/alerts/run (sent as "Authorization: Bearer …" by
# `npm run alerts:run` or a cron job). Required in production; in
# development the route also runs without it.
ALERTS_CRON_SECRET=

# ── Türkei-Kennzahlen ───────────────────────────────────────
# Schlüssel der TCMB-EVDS-Schnittstelle für `npm run tr:tufe`
# (Verbraucherpreisindex). Kostenlos unter https://evds3.tcmb.gov.tr.
# `npm run tr:kurs` (Euro-Kurs) braucht keinen Schlüssel.
EVDS_API_KEY=

# ── Tarife buchen (Stripe) ──────────────────────────────────
# Siehe docs/tarife-buchen.md. Ohne STRIPE_SECRET_KEY bietet `npm run dev`
# eine lokale Testzahlung an (BILLING_TEST_CHECKOUT=off schaltet sie ab);
# in Produktion kann dann nichts bestellt werden.
STRIPE_SECRET_KEY=                    # sk_test_… zum Testen, sk_live_… im Betrieb
STRIPE_WEBHOOK_SECRET=                # whsec_… des Webhook-Endpunkts /api/billing/webhook
STRIPE_PRICE_DE_INVESTOR_MONAT=       # price_… · 39,00 EUR, monatlich wiederkehrend
STRIPE_PRICE_DE_INVESTOR_QUARTAL=     # price_… · 99,00 EUR, einmalig
STRIPE_PRICE_DE_PRO_MONAT=            # price_… · 129,00 EUR, monatlich wiederkehrend
STRIPE_PRICE_DE_PRO_QUARTAL=          # price_… · 329,00 EUR, einmalig
STRIPE_PRICE_TR_INVESTOR_MONAT=       # price_… · 599,00 TRY, monatlich wiederkehrend
STRIPE_PRICE_TR_INVESTOR_QUARTAL=     # price_… · 1.490,00 TRY, einmalig
STRIPE_PRICE_TR_PRO_MONAT=            # price_… · 1.990,00 TRY, monatlich wiederkehrend
STRIPE_PRICE_TR_PRO_QUARTAL=          # price_… · 4.990,00 TRY, einmalig
STRIPE_AUTOMATIC_TAX=                 # "on" nur mit eingerichtetem Stripe Tax
# Erst nach Prüfung der Rechtstexte auf "yes" setzen — vorher ist keine Bestellung möglich.
BILLING_LEGAL_APPROVED=
BILLING_VAT_MODE=                     # "inclusive" (inkl. 19 % USt) oder "kleinunternehmer" (§ 19 UStG)
BILLING_TR_ENABLED=                   # leer/"yes" = Türkei in TL buchbar, "no" sperrt den Markt
BILLING_TR_KDV=                       # "inclusive" erst nach türkischer KDV-Registrierung: TL-Preise inkl. 20 % KDV
# BILLING_TEST_CHECKOUT=off
OPERATOR_EMAIL=                       # bekommt Widerrufe und Kündigungen in Kopie
