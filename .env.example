# ============================================================
# ENVIRONMENT VARIABLE TEMPLATE
# This file IS committed to git — it shows which variables
# are required. Never put real secrets here.
#
# To set up locally:
#   cp .env.example .env.local
#   fill in the values in .env.local
# ============================================================

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=                  # Public URL of the app (e.g. https://belowmark.com)

# ── PostgreSQL ──────────────────────────────────────────────
DATABASE_URL=                         # Full PostgreSQL connection string (e.g. postgresql://postgres:postgres@localhost:5432/belowmark)
